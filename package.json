{
  "name": "inga",
  "productName": "INGA",
  "version": "0.1.0",
  "description": "INGA Ist Nicht Genehmigungspflichtige Anschaffung – freie Schulbibliotheksverwaltung",
  "main": "src/main/main.js",
  "//desktopName": "Electron leitet daraus unter Linux die app_id und WM_CLASS ab; muss zum Namen der .desktop-Datei passen, sonst ordnen GNOME und KDE das laufende Fenster nicht dem Starter zu.",
  "desktopName": "inga.desktop",
  "license": "GPL-3.0-or-later",
  "private": true,
  "author": "Teyro",
  "repository": {
    "type": "git",
    "url": "https://github.com/teyro/inga.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win nsis:x64 nsis:arm64 portable:x64",
    "dist:linux": "electron-builder --linux AppImage:x64 deb:x64 rpm:x64"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.inga.bibliothek",
    "productName": "INGA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0",
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "",
        "LSApplicationCategoryType": "public.app-category.education"
      }
    },
    "dmg": {
      "title": "INGA ${version}",
      "contents": [
        { "x": 140, "y": 200 },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "INGA"
    },
    "linux": {
      "icon": "build/icon-flat.png",
      "maintainer": "Teyro <teyro@users.noreply.github.com>",
      "category": "Education",
      "synopsis": "Freie Schulbibliotheksverwaltung",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Keywords": "Bibliothek;Ausleihe;Mahnung;Katalog;Schule;"
        }
      },
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] }
      ]
    },
    "rpm": {
      "compression": "gzip",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ]
    }
  }
}
